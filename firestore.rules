rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection — authenticated users can read/write their own doc
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Community posts — any authenticated user can read; create if uid matches;
    // update only allowed to change the likes array (for like/unlike)
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['likes']);
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;
    }
  }
}
